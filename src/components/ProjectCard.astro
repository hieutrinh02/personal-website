---
const { project } = Astro.props;
---

<article class="project-card">
  <div class="project-card-header">
    <h3>{project.name}</h3>
    {project.links?.length > 0 && (
      <div class="project-links" aria-label={`${project.name} links`}>
        {project.links.map((link: { label: string; href: string }) => (
          <a
            class="icon-link"
            href={link.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`${project.name} on ${link.label}`}
            title={link.label}
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
              <path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.53 2.87 8.38 6.84 9.74.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.78.62-3.37-1.22-3.37-1.22-.45-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.63-1.38-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.36 9.36 0 0 1 12 6.96c.85 0 1.7.12 2.5.34 1.9-1.33 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.95.68 1.92 0 1.38-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z" />
            </svg>
          </a>
        ))}
      </div>
    )}
  </div>
  <div>
    <p>{project.description}</p>
  </div>
  <ul class="tag-list" aria-label={`${project.name} technologies`}>
    {project.tags.map((tag: string) => <li>{tag}</li>)}
  </ul>
</article>
